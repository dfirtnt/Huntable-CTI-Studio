# CTI Studio environment configuration
# Copy to .env and fill in the two required values.
# Everything else is configured in the Settings UI after first run.

# Required: PostgreSQL database password
POSTGRES_PASSWORD=your_secure_postgres_password_change_this
# Required for Docker-backed backup/restore requests from the web UI. Generate
# a long random value; it authorizes the internal-only maintenance service.
MAINTENANCE_API_TOKEN=

# LLM API keys (set whichever providers you use)
# These seed the Settings UI on first run; after that the UI manages them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Codex subscription workflow provider. Authenticate once inside the workflow
# worker with: docker compose exec workflow_worker codex login
WORKFLOW_CODEX_ENABLED=false
WORKFLOW_CODEX_MODEL=gpt-5.6-luna

# --- Security & Auth (Chunk A) ---
# Set APP_ENV=production to enable fail-closed startup checks.
APP_ENV=development
# disabled | trusted_header | oidc(reserved). production + disabled fails startup
# unless ALLOW_INSECURE_PRODUCTION_AUTH_DISABLED=true.
AUTH_MODE=disabled
ALLOW_INSECURE_PRODUCTION_AUTH_DISABLED=false

# Host/CORS allowlists are enforced only when APP_ENV=production (wildcards rejected there).
TRUSTED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8001

# Trusted-header SSO (used only when AUTH_MODE=trusted_header). The upstream
# proxy MUST strip client-supplied X-Huntable-* headers, then set verified ones.
AUTH_TRUSTED_PROXY_HEADER=X-Huntable-Verified
AUTH_TRUSTED_PROXY_VALUE=true
# Restrict which immediate peer IPs may supply identity headers. REQUIRED when
# APP_ENV=production and AUTH_MODE=trusted_header (startup fails closed on an
# empty list, since any direct peer could otherwise forge identity headers).
# Entries are literal IPs matched exactly against the TCP peer -- no wildcards
# or CIDR ranges (production rejects non-literal entries at startup).
# Only set ALLOW_INSECURE_PRODUCTION_TRUSTED_PROXY_OPEN=true when direct access
# to the app is blocked at the network level.
AUTH_TRUSTED_PROXY_IPS=
ALLOW_INSECURE_PRODUCTION_TRUSTED_PROXY_OPEN=false
AUTH_USER_ID_HEADER=X-Huntable-User-Id
AUTH_EMAIL_HEADER=X-Huntable-Email
AUTH_NAME_HEADER=X-Huntable-Name
AUTH_GROUPS_HEADER=X-Huntable-Groups
# Map IdP group names to roles (comma-separated). Do not commit real customer groups.
AUTH_ADMIN_GROUPS=
AUTH_OPERATOR_GROUPS=
AUTH_REVIEWER_GROUPS=
AUTH_ANALYST_GROUPS=

# --- Route authorization & CSRF (Chunk B) ---
# SECRET_KEY signs CSRF tokens. REQUIRED in production whenever CSRF is active
# (the default under any non-disabled AUTH_MODE). Must be a strong, non-default
# value of at least 16 chars; production startup fails otherwise. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# auto (default) = CSRF active whenever auth is enabled (cookie-backed proxy
# assumption); true = always on; false = bearer-only/cookieless deployment with
# CSRF intentionally disabled (document why at the proxy layer).
CSRF_ENABLED=auto

# Audit retention window for admin-triggered audit cleanup. Audit rows are
# database-backed and mutable by DB administrators; forward exports/logs to SIEM
# or append-only storage if you need stronger tamper evidence.
AUDIT_RETENTION_DAYS=365

# --- MCP over streamable-HTTP (Docker MCP Gateway) ---
# Only needed for the `mcp` compose profile. The stdio transport used by desktop
# MCP clients ignores these entirely.
#
# HUNTABLE_MCP_TOKEN is the bearer token the endpoint requires on every request.
# It fronts execute_sql and the audited write tools, so the server refuses to
# start without one of at least 32 characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The same value goes into the Gateway's secret store:
#   docker mcp secret set huntable.mcp_token=<value>
HUNTABLE_MCP_TOKEN=
# Host port the endpoint is published on, bound to 127.0.0.1 only.
HUNTABLE_MCP_PORT=8009
